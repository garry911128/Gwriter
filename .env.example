# 複製為 .env 後再啟動：  cp .env.example .env
# .env 已被 .gitignore 排除，請勿提交。

# --- MySQL (docker-compose 的 db 服務會讀這些變數建立資料庫) ---
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=mydatabase

# 對外映射的 MySQL 埠（本機用 dev.ps1 直連時會用到）
DB_HOST_PORT=3409

# --- 後端 ---
# docker compose 會覆寫為容器內位址；本機 go run 時才用得到這一行
DATABASE_URL=root:password@tcp(localhost:3409)/mydatabase

# 允許的前端來源。不使用萬用字元 *。
# 本機 vite dev 用 5173；docker compose 會自動改成 3000。
CORS_ALLOWED_ORIGIN=http://localhost:5173

# JWT 簽章金鑰，至少 32 個位元組。後端未設定時會直接終止。
# 正式使用請自行產生：openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gwriter

# --- 前端（build 時注入，見 frontend/Dockerfile 的 ARG） ---
VITE_API_BASE=http://localhost:8080/api/v1
